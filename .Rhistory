export_to_netcdf <- function(r_stack, out_dir, scenario, ensemble, varname, varunit = "unit", suffix = "") {
save_dir <- file.path(out_dir, scenario, varname)
# Ensure the directory exists
if (!dir.exists(save_dir)) {
dir.create(save_dir, recursive = TRUE, showWarnings = FALSE)
}
file_ending <- paste0(suffix, ".nc")
file_name <- if (scenario == "hindcast") {
paste0(scenario, "_", paste0(varname, suffix), file_ending)
} else {
paste0(scenario, "_", ensemble, "_", paste0(varname, suffix), file_ending)
}
with_progress({
writeCDF(
x = r_stack,
filename = file.path(save_dir, file_name),
varname = varname,
unit = varunit,
overwrite = TRUE,
zname = "time",
compression = 4
)
})
message("Exported NetCDF: ", file_name)
}
