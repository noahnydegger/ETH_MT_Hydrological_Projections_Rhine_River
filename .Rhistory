scenario = scenario,
pattern = ".*sund_rel_crop.*\\.nc$"
)
message("[", format(Sys.time(), "%H:%M:%S"), "] stats computed")
reference_sund_stats[, `:=`(
basin = "hydro_CH",
scenario = "none",
variant = "none",
horizon = "ref"
)]
