source("~/GitHub/ETH/ETH_MT_Hydrological_Projections_Rhine_River/R_scripts/prevah_preparation/glac_ch2018_plotting.R", echo=TRUE)
# Assume processed_data_list contains combined meteo and glacier data for each chain
lapply(names(processed_data_list), function(chain_name) {
data <- processed_data_list[[chain_name]]
# Temperature plot
temp_plot <- ggplot(data, aes(x = YYYY, y = temp_AVG)) +
geom_line(color = "red", size = 1) +
labs(
title = paste0("5-Year Mean Temperature (chain ", chain_name, ")"),
x = "Year",
y = "Temperature (°C)"
) +
theme_minimal()
# Glacier plot
glac_plot <- ggplot(data, aes(x = YYYY)) +
geom_line(aes(y = count_abla, color = "Ablation"), size = 1) +
geom_line(aes(y = count_accu, color = "Accumulation"), size = 1) +
geom_line(aes(y = count_glac, color = "Total Glacier"), size = 1) +
labs(
title = paste0("Glacier Counts (chain ", chain_name, ")"),
x = "Year",
y = "Cell Count",
color = "Legend"
) +
theme_minimal() +
theme(
legend.position = "top",
plot.title = element_text(hjust = 0.5)
)
# Display combined plots with chain name as the title
plot_combined <- grid.arrange(
temp_plot, glac_plot,
ncol = 1,
top = textGrob(chain_name, gp = gpar(fontsize = 15, fontface = "bold"))
)
# save the plot as a pdf file
save_dir <- file.path(here::here(), "Plots", "glac_2018")
if (!dir.exists(save_dir)) {
dir.create(save_dir)
}
print(save_dir)
ggsave(file.path(save_dir, paste0(chain_name , ".pdf")), plot = plot_combined, device = "pdf", width = 12, height = 12)
})
