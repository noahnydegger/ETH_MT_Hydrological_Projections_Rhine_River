eps <- 1e-6  # to avoid log(0)
dt_subset[, (paste0(scale_cols, "_logit")) := lapply(.SD, function(x) {
x <- pmax(pmin(x, 1 - eps), eps)  # clamp to (eps, 1 - eps)
log(x / (1 - x))
}),
by = c(group_cols),
.SDcols = scale_cols]
